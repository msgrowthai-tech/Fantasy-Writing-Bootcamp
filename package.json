{
  "name": "fwb-command-center",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "concurrently -k \"node --env-file-if-exists=.env --watch server/index.js\" \"vite --host 0.0.0.0\"",
    "build": "vite build",
    "start": "node --env-file-if-exists=.env server/index.js",
    "test": "node --test tests/*.test.js",
    "import": "python scripts/import_workbooks.py",
    "seed": "node --env-file-if-exists=.env scripts/seed-supabase.js",
    "test:browser": "node scripts/browser-smoke.js"
  },
  "dependencies": {
    "@fontsource/inter": "^5.3.0",
    "@fontsource/montserrat": "^5.3.0",
    "@supabase/supabase-js": "^2.80.0",
    "concurrently": "^9.2.1",
    "express": "^5.1.0",
    "lucide-react": "^0.468.0",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "recharts": "^3.4.0"
  },
  "devDependencies": {
    "playwright": "^1.65.0",
    "prettier": "^3.9.10",
    "vite": "^7.2.0"
  }
}
